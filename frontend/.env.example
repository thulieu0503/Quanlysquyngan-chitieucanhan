# Sao chép file này thành .env.local (dev) rồi điền giá trị thật.
# .env.local KHÔNG được commit lên git (đã có trong .gitignore).

# --- Database (MySQL) ---
# Khi chạy MySQL bằng docker-compose ở máy local, dùng đúng các giá trị dưới đây.
# Cổng 3307 (không phải 3306 mặc định) để tránh trùng với MySQL cài native trên máy, nếu có.
DB_HOST=localhost
DB_PORT=3307
DB_USER=finance_user
DB_PASSWORD=finance_password
DB_NAME=finance_app

# --- NextAuth ---
# Tạo secret ngẫu nhiên: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Email (đặt lại mật khẩu, reminder) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VíVàng <no-reply@vivang.app>"
