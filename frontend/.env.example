# Sao chép file này thành .env.local (dev) rồi điền giá trị thật.
# .env.local KHÔNG được commit lên git (đã có trong .gitignore).

# --- Backend API (FastAPI, xem thư mục backend/) ---
# Next.js chỉ là client: mọi request /api/* được next.config.mjs rewrite sang backend này.
BACKEND_URL=http://localhost:8000
