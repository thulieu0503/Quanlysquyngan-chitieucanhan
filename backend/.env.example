# Sao chép file này thành .env (dev) rồi điền giá trị thật.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=finance_user
DB_PASSWORD=finance_password
DB_NAME=finance_app

# --- JWT / OTP ---
# Tạo secret ngẫu nhiên: openssl rand -base64 32
JWT_SECRET=

# --- Email (đặt lại mật khẩu, reminder) ---
# Dev: chạy `docker compose up -d mailpit`, đặt SMTP_HOST=localhost, SMTP_PORT=1025
# rồi xem thư tại http://localhost:8025. Để trống SMTP_HOST thì nội dung mail chỉ được in ra console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VíVàng <no-reply@vivang.app>"

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

ENV=development
