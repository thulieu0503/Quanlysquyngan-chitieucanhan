    "name": "VíVàng - Quản lý Thu Chi Cá Nhân API",
    "description": "Bộ sưu tập Postman hoàn chỉnh cho ứng dụng Quản lý Thu Chi Cá Nhân (VíVàng). Bao gồm toàn bộ API Xác thực, Giao dịch, Danh mục, Ngân sách, Báo cáo, Nhắc nhở và Quản trị Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Hệ thống & Sức khỏe",
      "item": [
        {
          "name": "Kiểm tra trạng thái (Health Check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
