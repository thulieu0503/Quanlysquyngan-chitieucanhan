            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 5,\n  \"type\": \"expense\",\n  \"amount\": 65000,\n  \"transactionDate\": \"2026-09-27\",\n  \"note\": \"Cà phê và ăn sáng\"\n}"
